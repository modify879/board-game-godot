# 서버로 가는 연결을 재사용한다 — 요청마다 새 연결을 맺으면 도커 NAT 에서 가끔 연결 시도가 버려져 10~25초 멈춘다(QA 측정)
upstream api_upstream {
    server ${SERVER_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_static on; # 빌드 때 만든 .gz 를 그대로 보낸다 — 40MB wasm 을 요청마다 압축하지 않는다
    gzip_types application/wasm application/javascript text/css application/json application/octet-stream;
    gzip_min_length 1024;

    location / {
        # Godot 내보내기 파일 이름(index.wasm/pck/js)이 매번 같다 — 재배포 뒤 옛 파일과 섞이지 않게 매번 ETag 로 재검증한다
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }

    location /api/ {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://${SERVER_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_read_timeout 1h;
    }
}
