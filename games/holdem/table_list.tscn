[node name="CreateButton" type="Button" parent="VBoxContainer/CreateRow/HBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "방 만들기"

[node name="ErrorLabel" type="Label" parent="VBoxContainer"]
unique_name_in_owner = true
visible = false
