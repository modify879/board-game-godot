layout_mode = 2
text = "← 로비"

[node name="TitleLabel" type="Label" parent="VBoxContainer/TopBar/HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
text = "텍사스 홀덤"

[node name="RefreshButton" type="Button" parent="VBoxContainer/TopBar/HBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "새로고침"

[node name="CreateRow" type="MarginContainer" parent="VBoxContainer"]
layout_mode = 2
