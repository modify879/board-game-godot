[node name="HBoxContainer" type="HBoxContainer" parent="VBoxContainer/CreateRow"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="NameEdit" type="LineEdit" parent="VBoxContainer/CreateRow/HBoxContainer"]
